# LLM API Keys (Configurable - Fallback to procedural synthesizer if omitted)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration (PostgreSQL / SQLite via SQLAlchemy)
DATABASE_URL=sqlite:///agent_baseline.db
# DATABASE_URL=postgresql://user:password@localhost:5432/agent_baseline

# Redis Configuration (Optional - Fallback to in-memory cache if omitted)
REDIS_HOST=localhost
REDIS_PORT=6379

# Server Settings
PORT=8000
HOST=0.0.0.0
